# deskflip config (zsh syntax)
# Location: ~/.config/deskflip/config   (override with DESKFLIP_CONFIG)

# --- Displays ---------------------------------------------------------------
# Give each display a short name and its UUID from `deskflip ids`.
# Identical monitor models can't be told apart by name; use the POSITION
# column to see which one is which.
DISPLAYS=(
  left    "00000000-0000-0000-0000-000000000001"
  bottom  "00000000-0000-0000-0000-000000000002"
  top     "00000000-0000-0000-0000-000000000003"
)

# Optional: DDC identifiers for m1ddc, if it doesn't accept the UUID above.
# Use the numbers from `m1ddc display list`. Displays not listed here use their UUID.
DDC_IDS=(
  # left  1
)

# --- Inputs -----------------------------------------------------------------
# DDC input codes (VCP 0x60). Common values: 15 = DisplayPort 1,
# 16 = DisplayPort 2, 17 = HDMI 1, 18 = HDMI 2, 27 = USB-C.
# These differ per monitor brand: check with `deskflip input` while each
# monitor is set to the input you want. Example: iiyama ProLite XUB2792QSN
# uses 19 for USB-C. Most monitors don't answer while set to another input,
# so read the code for DisplayPort/HDMI while the Mac is on that input.
INPUTS=(
  mac       27   # Mac via USB-C
  mac-hdmi  17   # Mac via HDMI
  laptop    15   # other computer via DisplayPort
)

# Inputs driven by this Mac. A display switched to any other input is
# disconnected from macOS, so no windows end up on a screen you can't see.
MAC_INPUTS=(mac mac-hdmi)

# --- Presets ----------------------------------------------------------------
# Each preset is a list of display:input pairs. Use "off" to disconnect a
# display from the Mac without switching its input.
PRESETS=(
  work  "left:laptop bottom:laptop top:mac"
  mac   "left:mac bottom:mac top:off"
  all   "left:mac bottom:mac top:mac"
)

# --- Timing (seconds) -------------------------------------------------------
CONNECT_DELAY=2   # wait after reconnecting displays, before DDC commands
SWITCH_DELAY=1    # wait after switching inputs, before disconnecting
SETTLE_TIMEOUT=10 # max wait for kept displays to come back before disconnecting others
